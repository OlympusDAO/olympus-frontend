    }
  },
  "lint-staged": {
    "!(src/locales)src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18",
    "npm": "use-pnpm",
    "pnpm": ">=10.33.0",
    "yarn": "use-pnpm"

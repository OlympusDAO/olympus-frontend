  "scripts": {
    "build": "vite build",
    "start": "vite dev",
    "test": "vitest --threads=false",
    "test:unit": "vitest --threads=false --coverage.enabled --coverage.reportOnFailure",
    "test:e2e": "vitest --threads=false --watchAll=false",
    "lint": "eslint --config ./.eslintrc.js ./src/ --ext .jsx,.js,.tsx,.ts",
    "lint:fix": "prettier --write ./src/ && pnpm run lint --fix",
    "theme": "npx gulp less",
    "watch": "node ./scripts/watch.js",
    "snapshot": "vitest -u ",
    "stats": "pnpm run build -- --stats && npx webpack-bundle-analyzer ./build/bundle-stats.json",
    "typechain:build": "pnpm exec typechain --target ethers-v5 --out-dir src/typechain src/abi/*.json src/abi/**/*.json",
    "postinstall": "node -e \"console.log('Skipping typechain on install; run pnpm run typechain:build manually.')\"",
    "prepare": "husky install",
    "codegen:bundle": "redocly bundle https://raw.githubusercontent.com/OlympusDAO/cooler-loans-api/main/apps/get/openapi/openapi.yml -o tmp/openapi.yaml",
    "codegen": "pnpm run codegen:bundle && orval && pnpm run lint:fix",
    "preinstall": "npx only-allow pnpm"
  },
  "resolutions": {
    "prompts": "2.4.2",
    "shell-quote": "1.7.3",
    "ejs": "3.1.8",
